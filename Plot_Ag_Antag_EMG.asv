%% Script to plot Raw EMG for Agonist and Antagonist EMG
function Plot_Ag_Antag_EMG(dataAv, figdir, savefigopt)
% inputs: dataAv - data table being plotted
% atime - time vector to plot
% figdir - where the output figures are saved (Ex. 'X:\ting\shared_ting\Scott\HOA_PD SRM\savedfigs\')
% savefigopt - option whether to save the figures or not (If true then figures will plot)
%% ID participants/directions
participants = unique(dataAv.patient);
direcs = unique(dataAv.pertdir_calc_round_deg);
try
    mags = unique(dataAv.pert_mag);
catch
    mags =  unique(dataAv.condition);
end
yl = [-1.2 1.2];
%% for loops to plot
for i = 1:length(participants) %participant loop
    participant = participants(i);
    for ii = 1:length(direcs) %direction loop
        direc = direcs(ii);
        fig_all = figure(100); hold on; set(gcf,'WindowState','maximized');
        ax_all = gca;
        Ag_colors = ["#fee0d2"; "#fc9272"; "#de2d26"];
        Antag_colors = ["#f0f0f0"; "#bdbdbd"; "#636363"];
        for iii = 1:length(mags) % magnitude loop
            mag = mags(iii);
            %% create index for dataAv
            try
                ind_cond = find(strcmp(dataAv.patient,participant) & dataAv.pertdir_calc_round_deg == direc & dataAv.pert_mag == mag);
            catch
                ind_cond = find(strcmp(dataAv.patient,participant) & dataAv.pertdir_calc_round_deg == direc & dataAv.condition == mag);
            end

            %% specify which muscle is acting as an agonist/antagonist
            if direc == 90 %forward pert
                agonist = dataAv.EMG_TA_L_norm(ind_cond,:); tag_ag='TA'; ag_norm = dataAv.EMG_TA_L_norm(ind_cond,:);
                antagonist = dataAv.EMG_MGAS_L_norm(ind_cond,:); tag_antag='MG'; antag_norm = dataAv.EMG_MGAS_L_norm(ind_cond,:);
            elseif direc == 270 %backward pert
                antagonist = dataAv.EMG_TA_L_norm(ind_cond,:); tag_antag='TA'; antag_norm = dataAv.EMG_TA_L_norm(ind_cond,:);
                agonist = dataAv.EMG_MGAS_L_norm(ind_cond,:); tag_ag='MG'; ag_norm = dataAv.EMG_MGAS_L_norm(ind_cond,:);
            else
                error('Unspecified Direction')
            end
            atime = dataAv.atime(ind_cond,:); % Modify CoM acc with stiction model from Welch and Ting 2009

            %% Plot Ag & Antag EMG for for single magnitude
            figure; hold on; set(gcf,'WindowState','maximized');
            plot(atime,agonist,'k', 'LineWidth',2)
            plot(atime,-antagonist,'r', 'LineWidth',2)
            legend("Ag (" + tag_ag + ")","Antag (" + tag_antag +")",'FontSize',18)
            xlabel('Time (s)'); ylabel('EMG (nu)')
            ylim(yl)
            title([participant + ' Mag: ' + num2str(mag) + " direc: " + num2str(direc)],'FontSize', 22)
            % Save Figure
            if savefigopt
                saveas(gcf,[figdir + participant + '_AgAntagEMG_mag' + num2str(mag) + '_direc' + num2str(direc) + '_' + date + '.fig'],'fig')
                saveas(gcf,[figdir + participant + '_AgAntagEMG_mag' + num2str(mag) + '_direc' + num2str(direc) + '_' + date + '.jpg'],'jpg')
                print(gcf,'-depsc2',[figdir + participant + '_AgAntagEMG_mag' + num2str(mag) + '_direc' + num2str(direc) + '_' + date + '.eps'])
            end

            %% Plot Ag and Antag EMG for all magnitudes in single direction
            plot(ax_all, atime, agonist, 'Color', Ag_colors(iii), 'LineWidth',2)
            plot(ax_all, atime, -antagonist, 'Color', Antag_colors(iii), 'LineWidth',2)

        end %mag loop
        %% set All magnitude figure options and save
        title(ax_all, [participant + " All Mags  direc: " + num2str(direc)],'FontSize', 22)
        legend(ax_all, "Ag_{low} (" + tag_ag + ")","Antag_{low} (" + tag_antag +")",...
            "Ag_{med}(" + tag_ag + ")","Antag_{med} (" + tag_antag +")",...
            "Ag_{hi} (" + tag_ag + ")","Antag_{hi} (" + tag_antag +")",...
            'FontSize',18)
        legend("Ag (" + tag_ag + ")","Antag (" + tag_antag +")",'FontSize',18)
        xlabel(ax_all,'Time (s)'); ylabel(ax_all, 'EMG (nu)')
        ylim(ax_all,yl)
        if savefigopt
            saveas(fig_all,[figdir + participant + '_AgAntagEMG_allmags_direc' + num2str(direc) + '_' + date + '.fig'],'fig')
            saveas(fig_all,[figdir + participant + '_AgAntagEMG_allmags_direc' + num2str(direc) + '_' + date + '.jpg'],'jpg')
            print(fig_all,'-depsc2',[figdir + participant + '_AgAntagEMG_mag' + num2str(mag) + '_direc' + num2str(direc) + '_' + date + '.eps'])
        end
        clf
    end % direction loop
    close all
end % participant loop

end
